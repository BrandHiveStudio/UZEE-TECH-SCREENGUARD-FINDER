# ──────────────────────────────────────────────────────────────────────────────
# UZEE TECH ScreenGuard Finder — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your Turso credentials.
# NEVER commit .env.local to git.

# Turso / libSQL Configuration
# In development, you can omit these to automatically use local SQLite (`file:local.db`).
# In production, set to your remote Turso database URL and Auth Token.
# Found via Turso CLI (`turso db show <db-name>`) or Turso Web Dashboard.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication & Password Reset
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars
NEXT_PUBLIC_APP_URL=https://finder.uzeetech.com.lk

# Gmail SMTP Configuration for Password Reset Emails
EMAIL_USER=uzeetechcare@gmail.com
# Google Account App Password (16 characters from myaccount.google.com/apppasswords)
EMAIL_PASS=your-16-char-gmail-app-password


# Legacy Supabase Configuration (Deprecated)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
